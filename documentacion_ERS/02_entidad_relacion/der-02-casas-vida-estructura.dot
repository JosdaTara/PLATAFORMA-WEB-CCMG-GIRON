digraph DER {
  graph [label=<<B>DER-02 · PVA: Áreas, Casas de Vida, participantes y ofrendas</B>>, labelloc="t", fontsize=16, fontname="Arial", rankdir=LR,
         nodesep=0.5, ranksep=0.9, splines=spline, pad=0.3, bgcolor="white", forcelabels=true];
  node [shape=plain, fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9, color="#555555", arrowsize=0.9, penwidth=1.1];
  AREA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D5EDD6"><B>AREA</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_area_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_area</B></TD><TD ALIGN="LEFT" PORT="id_area_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>nombre</B></TD><TD ALIGN="LEFT" PORT="nombre_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_supervisor_w"><FONT COLOR="#555555" POINT-SIZE="9">FK UK</FONT></TD><TD ALIGN="LEFT">id_supervisor</TD><TD ALIGN="LEFT" PORT="id_supervisor_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado_e"><FONT COLOR="#666666" POINT-SIZE="10">estado_general</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>un supervisor dirige como máximo un Área</I></FONT></TD></TR></TABLE>>];
  CASA_VIDA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D5EDD6"><B>CASA_VIDA</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_casa_vida</B></TD><TD ALIGN="LEFT" PORT="id_casa_vida_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>nombre</B></TD><TD ALIGN="LEFT" PORT="nombre_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_area_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_area</TD><TD ALIGN="LEFT" PORT="id_area_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_lider_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_lider</TD><TD ALIGN="LEFT" PORT="id_lider_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_supervisor_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_supervisor</TD><TD ALIGN="LEFT" PORT="id_supervisor_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="direccion_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">direccion</TD><TD ALIGN="LEFT" PORT="direccion_e"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado_e"><FONT COLOR="#666666" POINT-SIZE="10">estado_general</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actualizado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT" PORT="actualizado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>id_supervisor: copia redundante de AREA.id_supervisor</I></FONT></TD></TR></TABLE>>];
  CASA_VIDA_EQUIPO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D5EDD6"><B>CASA_VIDA_EQUIPO</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_equipo_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_casa_vida_equipo</B></TD><TD ALIGN="LEFT" PORT="id_casa_vida_equipo_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><B>id_casa_vida</B></TD><TD ALIGN="LEFT" PORT="id_casa_vida_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT" PORT="id_usuario_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="funcion_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>funcion</B></TD><TD ALIGN="LEFT" PORT="funcion_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>activo</B></TD><TD ALIGN="LEFT" PORT="activo_e"><FONT COLOR="#666666" POINT-SIZE="10">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>funcion: APRENDIZ, ANFITRION, MAESTRO_NINOS</I></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>UK (id_casa_vida, id_usuario)</I></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>UK (id_usuario) si activo</I></FONT></TD></TR></TABLE>>];
  CASA_VIDA_MIEMBRO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D5EDD6"><B>CASA_VIDA_MIEMBRO</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_miembro_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_casa_vida_miembro</B></TD><TD ALIGN="LEFT" PORT="id_casa_vida_miembro_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><B>id_casa_vida</B></TD><TD ALIGN="LEFT" PORT="id_casa_vida_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_participante_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><B>id_participante</B></TD><TD ALIGN="LEFT" PORT="id_participante_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_ingreso_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_ingreso</TD><TD ALIGN="LEFT" PORT="fecha_ingreso_e"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado_e"><FONT COLOR="#666666" POINT-SIZE="10">estado_general</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>UK (id_casa_vida, id_participante)</I></FONT></TD></TR></TABLE>>];
  PARTICIPANTE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D5EDD6"><B>PARTICIPANTE</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_participante_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_participante</B></TD><TD ALIGN="LEFT" PORT="id_participante_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombres_apellidos_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>nombres_apellidos</B></TD><TD ALIGN="LEFT" PORT="nombres_apellidos_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="documento_identidad_w"><FONT COLOR="#555555" POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT"><B>documento_identidad</B></TD><TD ALIGN="LEFT" PORT="documento_identidad_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_nacimiento_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_nacimiento</TD><TD ALIGN="LEFT" PORT="fecha_nacimiento_e"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="telefono_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">telefono</TD><TD ALIGN="LEFT" PORT="telefono_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="direccion_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">direccion</TD><TD ALIGN="LEFT" PORT="direccion_e"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="autorizacion_datos_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">autorizacion_datos</TD><TD ALIGN="LEFT" PORT="autorizacion_datos_e"><FONT COLOR="#666666" POINT-SIZE="10">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado_e"><FONT COLOR="#666666" POINT-SIZE="10">estado_general</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actualizado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT" PORT="actualizado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR></TABLE>>];
  OFRENDA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D5EDD6"><B>OFRENDA</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_ofrenda_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_ofrenda</B></TD><TD ALIGN="LEFT" PORT="id_ofrenda_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>fecha</B></TD><TD ALIGN="LEFT" PORT="fecha_e"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="concepto_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>concepto</B></TD><TD ALIGN="LEFT" PORT="concepto_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="valor_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>valor</B></TD><TD ALIGN="LEFT" PORT="valor_e"><FONT COLOR="#666666" POINT-SIZE="10">numeric(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_casa_vida</TD><TD ALIGN="LEFT" PORT="id_casa_vida_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_registro_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_usuario_registro</TD><TD ALIGN="LEFT" PORT="id_usuario_registro_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="modificado_por_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">modificado_por</TD><TD ALIGN="LEFT" PORT="modificado_por_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observacion_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">observacion</TD><TD ALIGN="LEFT" PORT="observacion_e"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actualizado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT" PORT="actualizado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>CHECK valor &gt; 0</I></FONT></TD></TR></TABLE>>];
  USUARIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555" STYLE="dashed"><TR><TD COLSPAN="3" BGCOLOR="#EEEEEE"><B>USUARIO</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT" PORT="id_usuario_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#777777" POINT-SIZE="9"><I>detalle en otra vista</I></FONT></TD></TR></TABLE>>];
  USUARIO:id_usuario_e:e -> AREA:id_supervisor_w:w [dir=both, arrowtail="teeodot", arrowhead="teeodot", xlabel="supervisa"];
  AREA:id_area_e:e -> CASA_VIDA:id_area_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="agrupa"];
  USUARIO:id_usuario_e:e -> CASA_VIDA:id_lider_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="lidera"];
  USUARIO:id_usuario_e:e -> CASA_VIDA:id_supervisor_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="copia redundante", style="dashed", color="#888888", fontcolor="#777777"];
  CASA_VIDA:id_casa_vida_e:e -> CASA_VIDA_EQUIPO:id_casa_vida_w:w [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="tiene"];
  USUARIO:id_usuario_e:e -> CASA_VIDA_EQUIPO:id_usuario_w:w [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="apoya en"];
  CASA_VIDA:id_casa_vida_e:e -> CASA_VIDA_MIEMBRO:id_casa_vida_w:w [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="integra"];
  PARTICIPANTE:id_participante_e:e -> CASA_VIDA_MIEMBRO:id_participante_w:w [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="pertenece"];
  CASA_VIDA:id_casa_vida_e:e -> OFRENDA:id_casa_vida_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="recibe"];
  USUARIO:id_usuario_e:e -> OFRENDA:id_usuario_registro_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="registra"];
  USUARIO:id_usuario_e:e -> OFRENDA:modificado_por_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="modifica", style="dashed", color="#888888", fontcolor="#777777"];
}
