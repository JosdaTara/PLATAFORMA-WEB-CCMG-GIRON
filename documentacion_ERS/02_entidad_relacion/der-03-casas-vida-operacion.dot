digraph DER {
  graph [label=<<B>DER-03 · PVA: actividades, asistencia, seguimiento y reportes</B>>, labelloc="t", fontsize=16, fontname="Arial", rankdir=LR,
         nodesep=0.5, ranksep=0.9, splines=spline, pad=0.3, bgcolor="white", forcelabels=true];
  node [shape=plain, fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9, color="#555555", arrowsize=0.9, penwidth=1.1];
  ACTIVIDAD [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#FCE8C8"><B>ACTIVIDAD</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_actividad_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_actividad</B></TD><TD ALIGN="LEFT" PORT="id_actividad_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_modulo_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>tipo_modulo</B></TD><TD ALIGN="LEFT" PORT="tipo_modulo_e"><FONT COLOR="#666666" POINT-SIZE="10">tipo_modulo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_casa_vida</TD><TD ALIGN="LEFT" PORT="id_casa_vida_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_proceso_formacion_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_proceso_formacion</TD><TD ALIGN="LEFT" PORT="id_proceso_formacion_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="titulo_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>titulo</B></TD><TD ALIGN="LEFT" PORT="titulo_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>fecha</B></TD><TD ALIGN="LEFT" PORT="fecha_e"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hora_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">hora</TD><TD ALIGN="LEFT" PORT="hora_e"><FONT COLOR="#666666" POINT-SIZE="10">time</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT" PORT="descripcion_e"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_responsable_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_responsable</TD><TD ALIGN="LEFT" PORT="id_responsable_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>CHECK arco exclusivo: casa XOR proceso</I></FONT></TD></TR></TABLE>>];
  ASISTENCIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#FCE8C8"><B>ASISTENCIA</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_asistencia_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_asistencia</B></TD><TD ALIGN="LEFT" PORT="id_asistencia_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_actividad_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><B>id_actividad</B></TD><TD ALIGN="LEFT" PORT="id_actividad_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_participante_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><B>id_participante</B></TD><TD ALIGN="LEFT" PORT="id_participante_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="presente_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">presente</TD><TD ALIGN="LEFT" PORT="presente_e"><FONT COLOR="#666666" POINT-SIZE="10">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observacion_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">observacion</TD><TD ALIGN="LEFT" PORT="observacion_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="registrado_por_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">registrado_por</TD><TD ALIGN="LEFT" PORT="registrado_por_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_registro</TD><TD ALIGN="LEFT" PORT="fecha_registro_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>UK (id_actividad, id_participante)</I></FONT></TD></TR></TABLE>>];
  SEGUIMIENTO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#FCE8C8"><B>SEGUIMIENTO</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_seguimiento_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_seguimiento</B></TD><TD ALIGN="LEFT" PORT="id_seguimiento_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_participante_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><B>id_participante</B></TD><TD ALIGN="LEFT" PORT="id_participante_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT" PORT="id_usuario_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_modulo_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>tipo_modulo</B></TD><TD ALIGN="LEFT" PORT="tipo_modulo_e"><FONT COLOR="#666666" POINT-SIZE="10">tipo_modulo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_proceso_formacion_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_proceso_formacion</TD><TD ALIGN="LEFT" PORT="id_proceso_formacion_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>fecha</B></TD><TD ALIGN="LEFT" PORT="fecha_e"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>tipo</B></TD><TD ALIGN="LEFT" PORT="tipo_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>estado</B></TD><TD ALIGN="LEFT" PORT="estado_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observacion_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>observacion</B></TD><TD ALIGN="LEFT" PORT="observacion_e"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actualizado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT" PORT="actualizado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>tipo: VISITA, LLAMADA, CONSEJERIA, OTRO</I></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>estado: ABIERTO, EN_PROCESO, CERRADO</I></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>CHECK proceso obligatorio si es de formación</I></FONT></TD></TR></TABLE>>];
  REPORTE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#FCE8C8"><B>REPORTE</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_reporte_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_reporte</B></TD><TD ALIGN="LEFT" PORT="id_reporte_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_reporte_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>tipo_reporte</B></TD><TD ALIGN="LEFT" PORT="tipo_reporte_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_modulo_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>tipo_modulo</B></TD><TD ALIGN="LEFT" PORT="tipo_modulo_e"><FONT COLOR="#666666" POINT-SIZE="10">tipo_modulo</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_envia_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario_envia</B></TD><TD ALIGN="LEFT" PORT="id_usuario_envia_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_destino_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_usuario_destino</TD><TD ALIGN="LEFT" PORT="id_usuario_destino_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_casa_vida</TD><TD ALIGN="LEFT" PORT="id_casa_vida_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_area_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_area</TD><TD ALIGN="LEFT" PORT="id_area_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_reporte_general_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_reporte_general</TD><TD ALIGN="LEFT" PORT="id_reporte_general_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="periodo_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>periodo</B></TD><TD ALIGN="LEFT" PORT="periodo_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inicio_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_inicio</TD><TD ALIGN="LEFT" PORT="fecha_inicio_e"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_fin_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_fin</TD><TD ALIGN="LEFT" PORT="fecha_fin_e"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observaciones_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">observaciones</TD><TD ALIGN="LEFT" PORT="observaciones_e"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ruta_archivo_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">ruta_archivo</TD><TD ALIGN="LEFT" PORT="ruta_archivo_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="enviado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">enviado_en</TD><TD ALIGN="LEFT" PORT="enviado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>tipo_reporte: CASA_VIDA, GENERAL_AREA</I></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>UK (id_casa_vida, periodo) si CASA_VIDA</I></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>UK (id_area, periodo) si GENERAL_AREA</I></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>CHECK fecha_inicio ≤ fecha_fin</I></FONT></TD></TR></TABLE>>];
  USUARIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555" STYLE="dashed"><TR><TD COLSPAN="3" BGCOLOR="#EEEEEE"><B>USUARIO</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT" PORT="id_usuario_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#777777" POINT-SIZE="9"><I>detalle en otra vista</I></FONT></TD></TR></TABLE>>];
  AREA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555" STYLE="dashed"><TR><TD COLSPAN="3" BGCOLOR="#EEEEEE"><B>AREA</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_area_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_area</B></TD><TD ALIGN="LEFT" PORT="id_area_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#777777" POINT-SIZE="9"><I>detalle en otra vista</I></FONT></TD></TR></TABLE>>];
  CASA_VIDA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555" STYLE="dashed"><TR><TD COLSPAN="3" BGCOLOR="#EEEEEE"><B>CASA_VIDA</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_casa_vida</B></TD><TD ALIGN="LEFT" PORT="id_casa_vida_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#777777" POINT-SIZE="9"><I>detalle en otra vista</I></FONT></TD></TR></TABLE>>];
  PARTICIPANTE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555" STYLE="dashed"><TR><TD COLSPAN="3" BGCOLOR="#EEEEEE"><B>PARTICIPANTE</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_participante_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_participante</B></TD><TD ALIGN="LEFT" PORT="id_participante_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#777777" POINT-SIZE="9"><I>detalle en otra vista</I></FONT></TD></TR></TABLE>>];
  PROCESO_FORMACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555" STYLE="dashed"><TR><TD COLSPAN="3" BGCOLOR="#EEEEEE"><B>PROCESO_FORMACION</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_proceso_formacion_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_proceso_formacion</B></TD><TD ALIGN="LEFT" PORT="id_proceso_formacion_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#777777" POINT-SIZE="9"><I>detalle en otra vista</I></FONT></TD></TR></TABLE>>];
  CASA_VIDA:id_casa_vida_e:e -> ACTIVIDAD:id_casa_vida_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="realiza"];
  PROCESO_FORMACION:id_proceso_formacion_e:e -> ACTIVIDAD:id_proceso_formacion_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="realiza"];
  USUARIO:id_usuario_e:e -> ACTIVIDAD:id_responsable_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="responsable", style="dashed", color="#888888", fontcolor="#777777"];
  ACTIVIDAD:id_actividad_e:e -> ASISTENCIA:id_actividad_w:w [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="registra"];
  PARTICIPANTE:id_participante_e:e -> ASISTENCIA:id_participante_w:w [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="asiste"];
  USUARIO:id_usuario_e:e -> ASISTENCIA:registrado_por_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="registrado por", style="dashed", color="#888888", fontcolor="#777777"];
  PARTICIPANTE:id_participante_e:e -> SEGUIMIENTO:id_participante_w:w [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="recibe"];
  USUARIO:id_usuario_e:e -> SEGUIMIENTO:id_usuario_w:w [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="registra"];
  PROCESO_FORMACION:id_proceso_formacion_e:e -> SEGUIMIENTO:id_proceso_formacion_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="contexto"];
  USUARIO:id_usuario_e:e -> REPORTE:id_usuario_envia_w:w [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="envía"];
  USUARIO:id_usuario_e:e -> REPORTE:id_usuario_destino_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="recibe", style="dashed", color="#888888", fontcolor="#777777"];
  CASA_VIDA:id_casa_vida_e:e -> REPORTE:id_casa_vida_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="reporte de casa"];
  AREA:id_area_e:e -> REPORTE:id_area_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="reporte general"];
  REPORTE:id_reporte_e:e -> REPORTE:id_reporte_general_e:e [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="agrupa"];
}
