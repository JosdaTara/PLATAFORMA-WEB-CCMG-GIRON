digraph DER {
  graph [label=<<B>DER-00 · Modelo general: entidades, claves y relaciones de negocio</B>>, labelloc="t", fontsize=16, fontname="Arial", rankdir=TB,
         nodesep=0.25, ranksep=0.45, splines=spline, pad=0.3, bgcolor="white", forcelabels=true];
  node [shape=plain, fontname="Arial", fontsize=16];
  edge [fontname="Arial", fontsize=14, color="#555555", arrowsize=0.9, penwidth=1.1];
  subgraph cluster_seg {
    label=<<B>Seguridad y auditoría</B>>; fontsize=17; style="rounded"; color="#BBBBBB"; bgcolor="#FCFCFC";
    ROL [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D6E4F0"><B>ROL</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_rol_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_rol</B></TD><TD PORT="id_rol_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_w"><FONT COLOR="#555555" POINT-SIZE="14">UK</FONT></TD><TD ALIGN="LEFT"><B>nombre</B></TD><TD PORT="nombre_e"></TD></TR></TABLE>>];
    USUARIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D6E4F0"><B>USUARIO</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD PORT="id_usuario_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_rol_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT"><B>id_rol</B></TD><TD PORT="id_rol_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="correo_w"><FONT COLOR="#555555" POINT-SIZE="14">UK</FONT></TD><TD ALIGN="LEFT"><B>correo</B></TD><TD PORT="correo_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="username_w"><FONT COLOR="#555555" POINT-SIZE="14">UK</FONT></TD><TD ALIGN="LEFT">username</TD><TD PORT="username_e"></TD></TR></TABLE>>];
    AUDITORIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D6E4F0"><B>AUDITORIA</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_auditoria_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_auditoria</B></TD><TD PORT="id_auditoria_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT">id_usuario</TD><TD PORT="id_usuario_e"></TD></TR></TABLE>>];
  }
  subgraph cluster_est {
    label=<<B>PVA – Estructura</B>>; fontsize=17; style="rounded"; color="#BBBBBB"; bgcolor="#FCFCFC";
    AREA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D5EDD6"><B>AREA</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_area_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_area</B></TD><TD PORT="id_area_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_supervisor_w"><FONT COLOR="#555555" POINT-SIZE="14">FK UK</FONT></TD><TD ALIGN="LEFT">id_supervisor</TD><TD PORT="id_supervisor_e"></TD></TR></TABLE>>];
    CASA_VIDA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D5EDD6"><B>CASA_VIDA</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_casa_vida</B></TD><TD PORT="id_casa_vida_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_area_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT">id_area</TD><TD PORT="id_area_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_lider_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT">id_lider</TD><TD PORT="id_lider_e"></TD></TR></TABLE>>];
    CASA_VIDA_EQUIPO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D5EDD6"><B>CASA_VIDA_EQUIPO</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_equipo_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_casa_vida_equipo</B></TD><TD PORT="id_casa_vida_equipo_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT"><B>id_casa_vida</B></TD><TD PORT="id_casa_vida_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD PORT="id_usuario_e"></TD></TR></TABLE>>];
    PARTICIPANTE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D5EDD6"><B>PARTICIPANTE</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_participante_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_participante</B></TD><TD PORT="id_participante_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="documento_identidad_w"><FONT COLOR="#555555" POINT-SIZE="14">UK</FONT></TD><TD ALIGN="LEFT"><B>documento_identidad</B></TD><TD PORT="documento_identidad_e"></TD></TR></TABLE>>];
    CASA_VIDA_MIEMBRO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D5EDD6"><B>CASA_VIDA_MIEMBRO</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_miembro_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_casa_vida_miembro</B></TD><TD PORT="id_casa_vida_miembro_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT"><B>id_casa_vida</B></TD><TD PORT="id_casa_vida_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_participante_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT"><B>id_participante</B></TD><TD PORT="id_participante_e"></TD></TR></TABLE>>];
    OFRENDA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D5EDD6"><B>OFRENDA</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_ofrenda_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_ofrenda</B></TD><TD PORT="id_ofrenda_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT">id_casa_vida</TD><TD PORT="id_casa_vida_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_registro_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT">id_usuario_registro</TD><TD PORT="id_usuario_registro_e"></TD></TR></TABLE>>];
  }
  subgraph cluster_ope {
    label=<<B>PVA – Operación</B>>; fontsize=17; style="rounded"; color="#BBBBBB"; bgcolor="#FCFCFC";
    ACTIVIDAD [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#FCE8C8"><B>ACTIVIDAD</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_actividad_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_actividad</B></TD><TD PORT="id_actividad_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT">id_casa_vida</TD><TD PORT="id_casa_vida_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_proceso_formacion_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT">id_proceso_formacion</TD><TD PORT="id_proceso_formacion_e"></TD></TR></TABLE>>];
    ASISTENCIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#FCE8C8"><B>ASISTENCIA</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_asistencia_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_asistencia</B></TD><TD PORT="id_asistencia_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_actividad_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT"><B>id_actividad</B></TD><TD PORT="id_actividad_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_participante_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT"><B>id_participante</B></TD><TD PORT="id_participante_e"></TD></TR></TABLE>>];
    SEGUIMIENTO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#FCE8C8"><B>SEGUIMIENTO</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_seguimiento_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_seguimiento</B></TD><TD PORT="id_seguimiento_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_participante_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT"><B>id_participante</B></TD><TD PORT="id_participante_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD PORT="id_usuario_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_proceso_formacion_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT">id_proceso_formacion</TD><TD PORT="id_proceso_formacion_e"></TD></TR></TABLE>>];
    REPORTE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#FCE8C8"><B>REPORTE</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_reporte_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_reporte</B></TD><TD PORT="id_reporte_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_envia_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario_envia</B></TD><TD PORT="id_usuario_envia_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_casa_vida_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT">id_casa_vida</TD><TD PORT="id_casa_vida_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_area_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT">id_area</TD><TD PORT="id_area_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_reporte_general_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT">id_reporte_general</TD><TD PORT="id_reporte_general_e"></TD></TR></TABLE>>];
  }
  subgraph cluster_for {
    label=<<B>Escuelas de Formación</B>>; fontsize=17; style="rounded"; color="#BBBBBB"; bgcolor="#FCFCFC";
    PROCESO_FORMACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#E8DDF2"><B>PROCESO_FORMACION</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_proceso_formacion_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_proceso_formacion</B></TD><TD PORT="id_proceso_formacion_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_coordinador_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT"><B>id_coordinador</B></TD><TD PORT="id_coordinador_e"></TD></TR></TABLE>>];
    INSCRIPCION_FORMACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#E8DDF2"><B>INSCRIPCION_FORMACION</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_inscripcion_w"><FONT COLOR="#555555" POINT-SIZE="14">PK</FONT></TD><TD ALIGN="LEFT"><B>id_inscripcion</B></TD><TD PORT="id_inscripcion_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_participante_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT"><B>id_participante</B></TD><TD PORT="id_participante_e"></TD></TR><TR><TD ALIGN="LEFT" PORT="id_proceso_formacion_w"><FONT COLOR="#555555" POINT-SIZE="14">FK</FONT></TD><TD ALIGN="LEFT"><B>id_proceso_formacion</B></TD><TD PORT="id_proceso_formacion_e"></TD></TR></TABLE>>];
  }
  ROL -> USUARIO [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="asigna"];
  AUDITORIA -> USUARIO [dir=both, arrowtail="crowodot", arrowhead="teeodot", xlabel="realiza"];
  USUARIO -> AREA [dir=both, arrowtail="teeodot", arrowhead="teeodot", xlabel="supervisa"];
  AREA -> CASA_VIDA [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="agrupa"];
  USUARIO -> CASA_VIDA [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="lidera"];
  CASA_VIDA -> CASA_VIDA_EQUIPO [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="tiene"];
  USUARIO -> CASA_VIDA_EQUIPO [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="apoya en"];
  CASA_VIDA -> CASA_VIDA_MIEMBRO [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="integra"];
  PARTICIPANTE -> CASA_VIDA_MIEMBRO [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="pertenece"];
  CASA_VIDA -> OFRENDA [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="recibe"];
  USUARIO -> OFRENDA [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="registra"];
  CASA_VIDA -> ACTIVIDAD [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="realiza"];
  PROCESO_FORMACION -> ACTIVIDAD [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="realiza"];
  ACTIVIDAD -> ASISTENCIA [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="registra"];
  PARTICIPANTE -> ASISTENCIA [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="asiste"];
  PARTICIPANTE -> SEGUIMIENTO [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="recibe"];
  USUARIO -> SEGUIMIENTO [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="registra"];
  PROCESO_FORMACION -> SEGUIMIENTO [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="contexto"];
  USUARIO -> REPORTE [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="envía"];
  CASA_VIDA -> REPORTE [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="reporte de casa"];
  AREA -> REPORTE [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="reporte general"];
  REPORTE -> REPORTE [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="agrupa"];
  USUARIO -> PROCESO_FORMACION [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="coordina"];
  PROCESO_FORMACION -> INSCRIPCION_FORMACION [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="inscribe"];
  PARTICIPANTE -> INSCRIPCION_FORMACION [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="se inscribe"];
}
