digraph DER {
  graph [label=<<B>DER-04 · Escuelas de Formación</B>>, labelloc="t", fontsize=16, fontname="Arial", rankdir=LR,
         nodesep=0.5, ranksep=0.9, splines=spline, pad=0.3, bgcolor="white", forcelabels=true];
  node [shape=plain, fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9, color="#555555", arrowsize=0.9, penwidth=1.1];
  PROCESO_FORMACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#E8DDF2"><B>PROCESO_FORMACION</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_proceso_formacion_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_proceso_formacion</B></TD><TD ALIGN="LEFT" PORT="id_proceso_formacion_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>nombre</B></TD><TD ALIGN="LEFT" PORT="nombre_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_proceso_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>tipo_proceso</B></TD><TD ALIGN="LEFT" PORT="tipo_proceso_e"><FONT COLOR="#666666" POINT-SIZE="10">tipo_proceso</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_coordinador_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><B>id_coordinador</B></TD><TD ALIGN="LEFT" PORT="id_coordinador_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT" PORT="descripcion_e"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado_e"><FONT COLOR="#666666" POINT-SIZE="10">estado_general</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actualizado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT" PORT="actualizado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>tipo_proceso: PASOS_VIDA, ESCUELAS_VIDA,</I></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>MODULOS_LIDERAZGO, MISIONES</I></FONT></TD></TR></TABLE>>];
  INSCRIPCION_FORMACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#E8DDF2"><B>INSCRIPCION_FORMACION</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_inscripcion_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_inscripcion</B></TD><TD ALIGN="LEFT" PORT="id_inscripcion_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_participante_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><B>id_participante</B></TD><TD ALIGN="LEFT" PORT="id_participante_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_proceso_formacion_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><B>id_proceso_formacion</B></TD><TD ALIGN="LEFT" PORT="id_proceso_formacion_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inscripcion_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">fecha_inscripcion</TD><TD ALIGN="LEFT" PORT="fecha_inscripcion_e"><FONT COLOR="#666666" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado_e"><FONT COLOR="#666666" POINT-SIZE="10">estado_general</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>UK (id_participante, id_proceso_formacion)</I></FONT></TD></TR></TABLE>>];
  USUARIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555" STYLE="dashed"><TR><TD COLSPAN="3" BGCOLOR="#EEEEEE"><B>USUARIO</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT" PORT="id_usuario_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#777777" POINT-SIZE="9"><I>detalle en otra vista</I></FONT></TD></TR></TABLE>>];
  PARTICIPANTE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555" STYLE="dashed"><TR><TD COLSPAN="3" BGCOLOR="#EEEEEE"><B>PARTICIPANTE</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_participante_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_participante</B></TD><TD ALIGN="LEFT" PORT="id_participante_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#777777" POINT-SIZE="9"><I>detalle en otra vista</I></FONT></TD></TR></TABLE>>];
  ACTIVIDAD [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555" STYLE="dashed"><TR><TD COLSPAN="3" BGCOLOR="#EEEEEE"><B>ACTIVIDAD</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_actividad_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_actividad</B></TD><TD ALIGN="LEFT" PORT="id_actividad_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_proceso_formacion_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_proceso_formacion</TD><TD ALIGN="LEFT" PORT="id_proceso_formacion_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#777777" POINT-SIZE="9"><I>detalle en otra vista</I></FONT></TD></TR></TABLE>>];
  SEGUIMIENTO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555" STYLE="dashed"><TR><TD COLSPAN="3" BGCOLOR="#EEEEEE"><B>SEGUIMIENTO</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_seguimiento_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_seguimiento</B></TD><TD ALIGN="LEFT" PORT="id_seguimiento_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_proceso_formacion_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_proceso_formacion</TD><TD ALIGN="LEFT" PORT="id_proceso_formacion_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD COLSPAN="3"><FONT COLOR="#777777" POINT-SIZE="9"><I>detalle en otra vista</I></FONT></TD></TR></TABLE>>];
  PROCESO_FORMACION:id_proceso_formacion_e:e -> ACTIVIDAD:id_proceso_formacion_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="realiza"];
  PROCESO_FORMACION:id_proceso_formacion_e:e -> SEGUIMIENTO:id_proceso_formacion_w:w [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="contexto"];
  USUARIO:id_usuario_e:e -> PROCESO_FORMACION:id_coordinador_w:w [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="coordina"];
  PROCESO_FORMACION:id_proceso_formacion_e:e -> INSCRIPCION_FORMACION:id_proceso_formacion_w:w [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="inscribe"];
  PARTICIPANTE:id_participante_e:e -> INSCRIPCION_FORMACION:id_participante_w:w [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="se inscribe"];
}
