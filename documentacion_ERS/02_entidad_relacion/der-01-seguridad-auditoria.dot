digraph DER {
  graph [label=<<B>DER-01 · Seguridad, usuarios y auditoría</B>>, labelloc="t", fontsize=16, fontname="Arial", rankdir=LR,
         nodesep=0.5, ranksep=0.9, splines=spline, pad=0.3, bgcolor="white", forcelabels=true];
  node [shape=plain, fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9, color="#555555", arrowsize=0.9, penwidth=1.1];
  ROL [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D6E4F0"><B>ROL</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_rol_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_rol</B></TD><TD ALIGN="LEFT" PORT="id_rol_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_w"><FONT COLOR="#555555" POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT"><B>nombre</B></TD><TD ALIGN="LEFT" PORT="nombre_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT" PORT="descripcion_e"><FONT COLOR="#666666" POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="acceso_casas_vida_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">acceso_casas_vida</TD><TD ALIGN="LEFT" PORT="acceso_casas_vida_e"><FONT COLOR="#666666" POINT-SIZE="10">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="acceso_escuelas_formacion_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">acceso_escuelas_formacion</TD><TD ALIGN="LEFT" PORT="acceso_escuelas_formacion_e"><FONT COLOR="#666666" POINT-SIZE="10">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>nombre: PASTOR, SUPERVISOR_AREA, LIDER_CASA_VIDA,</I></FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>APOYO_CASA_VIDA, COORDINADOR_FORMACION, SUPERADMIN</I></FONT></TD></TR></TABLE>>];
  USUARIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D6E4F0"><B>USUARIO</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT" PORT="id_usuario_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_rol_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><B>id_rol</B></TD><TD ALIGN="LEFT" PORT="id_rol_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_completo_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>nombre_completo</B></TD><TD ALIGN="LEFT" PORT="nombre_completo_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="correo_w"><FONT COLOR="#555555" POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT"><B>correo</B></TD><TD ALIGN="LEFT" PORT="correo_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="username_w"><FONT COLOR="#555555" POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT" PORT="username_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>password_hash</B></TD><TD ALIGN="LEFT" PORT="password_hash_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">activo</TD><TD ALIGN="LEFT" PORT="activo_e"><FONT COLOR="#666666" POINT-SIZE="10">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="intentos_fallidos_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">intentos_fallidos</TD><TD ALIGN="LEFT" PORT="intentos_fallidos_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="bloqueado_hasta_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">bloqueado_hasta</TD><TD ALIGN="LEFT" PORT="bloqueado_hasta_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ultimo_acceso_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">ultimo_acceso</TD><TD ALIGN="LEFT" PORT="ultimo_acceso_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="debe_cambiar_password_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>debe_cambiar_password</B></TD><TD ALIGN="LEFT" PORT="debe_cambiar_password_e"><FONT COLOR="#666666" POINT-SIZE="10">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="responsable_ofrendas_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>responsable_ofrendas</B></TD><TD ALIGN="LEFT" PORT="responsable_ofrendas_e"><FONT COLOR="#666666" POINT-SIZE="10">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_por_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">creado_por</TD><TD ALIGN="LEFT" PORT="creado_por_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="modificado_por_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">modificado_por</TD><TD ALIGN="LEFT" PORT="modificado_por_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actualizado_en_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT" PORT="actualizado_en_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9"><I>UK lower(correo)</I></FONT></TD></TR></TABLE>>];
  AUDITORIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#D6E4F0"><B>AUDITORIA</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_auditoria_w"><FONT COLOR="#555555" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><B>id_auditoria</B></TD><TD ALIGN="LEFT" PORT="id_auditoria_e"><FONT COLOR="#666666" POINT-SIZE="10">serial</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_w"><FONT COLOR="#555555" POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_usuario</TD><TD ALIGN="LEFT" PORT="id_usuario_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="accion_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>accion</B></TD><TD ALIGN="LEFT" PORT="accion_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="entidad_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><B>entidad</B></TD><TD ALIGN="LEFT" PORT="entidad_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_entidad_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">id_entidad</TD><TD ALIGN="LEFT" PORT="id_entidad_e"><FONT COLOR="#666666" POINT-SIZE="10">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ip_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">ip</TD><TD ALIGN="LEFT" PORT="ip_e"><FONT COLOR="#666666" POINT-SIZE="10">varchar(45)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_w"><FONT COLOR="#555555" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT" PORT="fecha_e"><FONT COLOR="#666666" POINT-SIZE="10">timestamptz</FONT></TD></TR></TABLE>>];
  ROL:id_rol_e:e -> USUARIO:id_rol_w:w [dir=both, arrowtail="teetee", arrowhead="crowodot", xlabel="asigna"];
  USUARIO:id_usuario_e:e -> USUARIO:creado_por_e:e [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="crea", style="dashed", color="#888888", fontcolor="#777777"];
  USUARIO:id_usuario_e:e -> USUARIO:modificado_por_e:e [dir=both, arrowtail="teeodot", arrowhead="crowodot", xlabel="modifica", style="dashed", color="#888888", fontcolor="#777777"];
  AUDITORIA:id_usuario_e:e -> USUARIO:id_usuario_w:w [dir=both, arrowtail="crowodot", arrowhead="teeodot", xlabel="realiza"];
}
