@startuml cu-03-casas-vida-pastor
' Figura CU-03. Casos de uso: módulo PVA – Casas de Vida, gestión del Pastor
' Fuentes: RF05, RF07, RF10, RF11, RF15, RF16, RF26, RF27, RF28, RN20, RN24;
'          pva/views.py (PastorCasasMixin), pva/views_importacion.py, pva/views_reportes.py
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 13
skinparam ArrowColor #555555
skinparam ArrowFontSize 11
skinparam actorBorderColor #2C3E50
skinparam usecaseBackgroundColor #EAF4FB
skinparam usecaseBorderColor #2C3E50
skinparam rectangleBorderColor #2C3E50
skinparam rectangleFontStyle bold
left to right direction

title Módulo PVA – Casas de Vida: gestión del Pastor

actor "Pastor" as PA

rectangle "Módulo PVA – Casas de Vida" {
  usecase "Gestionar Áreas\n<size:10>RN20</size>" as UCAR
  usecase "Gestionar Casas de Vida\n<size:10>RF07</size>" as UC07
  usecase "Gestionar participantes\n<size:10>RF05</size>" as UC05
  usecase "Desactivar / reactivar\nregistro\n<size:10>RF28</size>" as UC28
  usecase "Importar datos\n(CSV / Excel)\n<size:10>RF26</size>" as UC26
  usecase "Gestionar seguimiento\nde participantes\n<size:10>RF11</size>" as UC11
  usecase "Consultar asistencia\n<size:10>RF10</size>" as UC10
  usecase "Consultar reportes\n<size:10>RF15</size>" as UC15
  usecase "Generar reporte\nconsolidado\n<size:10>RF16</size>" as UC16
  usecase "Exportar a PDF / Excel\n<size:10>RF27</size>" as UC27
}

PA -- UCAR
PA -- UC07
PA -- UC05
PA -- UC26
PA -- UC11
PA -- UC10
PA -- UC15
PA -- UC16

UCAR <.. UC28 : <<extend>>
UC07 <.. UC28 : <<extend>>
UC05 <.. UC28 : <<extend>>
UC15 <.. UC27 : <<extend>>
UC16 <.. UC27 : <<extend>>
@enduml
