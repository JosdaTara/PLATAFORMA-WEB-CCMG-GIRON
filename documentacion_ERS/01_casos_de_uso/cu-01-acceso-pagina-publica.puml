@startuml cu-01-acceso-pagina-publica
' Figura CU-01. Casos de uso: acceso a la plataforma y página pública
' Fuentes: RF01, RF02, RF23, RF24, RF25; cuentas/urls.py, publico/urls.py
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 13
skinparam ArrowColor #555555
skinparam ArrowFontSize 11
skinparam actorBorderColor #2C3E50
skinparam usecaseBackgroundColor #EAF4FB
skinparam usecaseBorderColor #2C3E50
skinparam rectangleBorderColor #2C3E50
skinparam rectangleFontStyle bold
left to right direction

title Acceso a la plataforma y página pública

actor "Miembro Asistente" as MA
actor "//Usuario registrado//" as UR

rectangle "Plataforma web PVA – CCMG Girón" {
  usecase "Consultar información\npública de la iglesia\n<size:10>RF24</size>" as UC24
  usecase "Iniciar sesión\n<size:10>RF01</size>" as UC01
  usecase "Visualizar panel\nprincipal por rol\n<size:10>RF23</size>" as UC23
  usecase "Recuperar contraseña\n<size:10>RF25</size>" as UC25a
  usecase "Cambiar contraseña\n<size:10>RF25</size>" as UC25b
  usecase "Cerrar sesión\n<size:10>RF02</size>" as UC02
}

MA -- UC24
UR -- UC01
UR -- UC25b
UR -- UC02

UC01 ..> UC23 : <<include>>
UC01 <.. UC25a : <<extend>>\nolvidó la contraseña
@enduml
