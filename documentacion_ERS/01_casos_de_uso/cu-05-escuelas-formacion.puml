@startuml cu-05-escuelas-formacion
' Figura CU-05. Casos de uso: módulo Escuelas de Formación
' Fuentes: RF05, RF09, RF11, RF12, RF15, RF16, RF18–RF22, RF27, RF28, RN13, RN24;
'          formacion/urls.py, formacion/views.py, formacion/alcance.py (procesos_visibles)
' Convención de distribución: actores a la izquierda escritos "ACTOR -- CU";
' actores a la derecha escritos "CU -- ACTOR". Las asociaciones no llevan flecha.
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 13
skinparam ArrowColor #555555
skinparam ArrowFontSize 11
skinparam actorBorderColor #2C3E50
skinparam usecaseBackgroundColor #EAF4FB
skinparam usecaseBorderColor #2C3E50
skinparam rectangleBorderColor #2C3E50
skinparam rectangleFontStyle bold
left to right direction

title Módulo Escuelas de Formación

actor "Pastor\n<size:11>(todos los procesos)</size>" as PA
actor "Coordinador de Formación\n<size:11>(solo los procesos que coordina)</size>" as CO

rectangle "Módulo Escuelas de Formación" {
  usecase "Generar reporte\nde formación\n<size:10>RF15, RF16</size>" as UC16f
  usecase "Exportar a PDF / Excel\n<size:10>RF27</size>" as UC27
  usecase "Gestionar seguimiento\nde formación\n<size:10>RF11</size>" as UC11f
  usecase "Gestionar procesos de formación\n(Pasos de Vida, Escuelas Vida,\nMódulos de Liderazgo, Misiones)\n<size:10>RF18–RF22</size>" as UC18
  usecase "Desactivar / reactivar\nproceso\n<size:10>RF28, RN24</size>" as UC28
  usecase "Retirar / reincorporar\ninscripción\n<size:10>RF19–RF22</size>" as UCRE
  usecase "Registrar actividad\ny asistencia\n<size:10>RF09, RF12</size>" as UC09f
  usecase "Gestionar participantes\nde formación\n<size:10>RF05</size>" as UC05f
  usecase "Inscribir participante\nen un proceso\n<size:10>RF19–RF22</size>" as UCIN
}

PA -- UC16f
PA -- UC11f
PA -- UC18
PA -- UC28
PA -- UCRE
PA -- UC09f
PA -- UC05f
PA -- UCIN

UC16f -- CO
UC11f -- CO
UC18 -- CO
UCRE -- CO
UC09f -- CO
UC05f -- CO
UCIN -- CO

UC05f .[norank].> UCIN : <<include>>\nal registrar
UC16f <.. UC27 : <<extend>>
@enduml
