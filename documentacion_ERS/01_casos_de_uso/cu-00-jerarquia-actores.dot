  t1 [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C3E50" BGCOLOR="white" FIXEDSIZE="TRUE" WIDTH="598" HEIGHT="83"><TR><TD BGCOLOR="#D6E4F0" ALIGN="LEFT" WIDTH="594"><FONT POINT-SIZE="13"><B>Super Administrador</B></FONT><FONT POINT-SIZE="10" COLOR="#4A5A68">   rol: SUPERADMIN</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="11">Gestiona toda la plataforma y consulta la bitácora de auditoría.<BR/><B>Es el único que crea Administradores y otros Super Administradores.</B></FONT></TD></TR></TABLE>>, pos="543.6,766.8!"];
  t2 [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C3E50" BGCOLOR="white" FIXEDSIZE="TRUE" WIDTH="598" HEIGHT="83"><TR><TD BGCOLOR="#D6E4F0" ALIGN="LEFT" WIDTH="594"><FONT POINT-SIZE="13"><B>Administrador (Pastor)</B></FONT><FONT POINT-SIZE="10" COLOR="#4A5A68">   rol: PASTOR</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="11">Administra el PVA y las Escuelas de Formación: usuarios, Áreas, Casas de Vida,<BR/>participantes, ofrendas y reportes. <B>Crea las cuentas de los niveles 3 a 5</B><BR/>y autoriza al responsable de ofrendas.</FONT></TD></TR></TABLE>>, pos="543.6,655.2!"];
  t3 [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C3E50" BGCOLOR="white" FIXEDSIZE="TRUE" WIDTH="598" HEIGHT="76"><TR><TD BGCOLOR="#D5ECEF" ALIGN="LEFT" WIDTH="594"><FONT POINT-SIZE="13"><B>Supervisor de Área</B></FONT><FONT POINT-SIZE="10" COLOR="#4A5A68">   rol: SUPERVISOR_AREA</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="11">Supervisa, en solo lectura, las Casas de Vida de su Área.<BR/>Recibe los reportes semanales y envía el reporte general al Administrador.</FONT></TD></TR></TABLE>>, pos="543.6,504.0!"];
  t4 [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C3E50" BGCOLOR="white" FIXEDSIZE="TRUE" WIDTH="598" HEIGHT="76"><TR><TD BGCOLOR="#D5ECEF" ALIGN="LEFT" WIDTH="594"><FONT POINT-SIZE="13"><B>Coordinador de Escuelas de Formación</B></FONT><FONT POINT-SIZE="10" COLOR="#4A5A68">   rol: COORDINADOR_FORMACION</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="11">Gestiona los procesos de formación que coordina (Pasos de Vida, Escuelas Vida,<BR/>Módulos de Liderazgo, Misiones): participantes, asistencia, seguimiento y reportes.</FONT></TD></TR></TABLE>>, pos="543.6,392.4!"];
  t5 [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#2C3E50" BGCOLOR="white" FIXEDSIZE="TRUE" WIDTH="598" HEIGHT="83"><TR><TD BGCOLOR="#D5ECEF" ALIGN="LEFT" WIDTH="594"><FONT POINT-SIZE="13"><B>Líder de Casa de Vida y su equipo de trabajo</B></FONT><FONT POINT-SIZE="10" COLOR="#4A5A68">   rol: LIDER_CASA_VIDA · APOYO_CASA_VIDA</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="11">Consultan su Casa de Vida, registran la asistencia y envían el reporte semanal<BR/>al Supervisor de Área. Equipo de trabajo: Aprendiz, Anfitrión y Maestro de Niños.</FONT></TD></TR></TABLE>>, pos="543.6,277.2!"];
