# Copie este archivo como .env (en la raíz del proyecto) y complete los valores.
# El archivo .env nunca debe subirse al repositorio.

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=CCMG_GIRON
DB_USER=postgres
DB_PASSWORD=cambie-esta-contraseña

# Base de datos de demostración (opcional, config.settings.demo)
DB_NAME_DEMO=CCMG_GIRON_demo

# Correo (recuperación de contraseña y avisos). Sin EMAIL_HOST, en desarrollo los correos
# solo se muestran en la consola del servidor. Con Gmail: active la verificación en dos pasos
# y cree una «contraseña de aplicación» en https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=correo-de-la-iglesia@gmail.com
EMAIL_HOST_PASSWORD=contraseña-de-aplicación-de-16-letras
DEFAULT_FROM_EMAIL=CCMG Girón <correo-de-la-iglesia@gmail.com>

# Solo producción (config.settings.production)
DJANGO_SECRET_KEY=genere-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=midominio.org,www.midominio.org
